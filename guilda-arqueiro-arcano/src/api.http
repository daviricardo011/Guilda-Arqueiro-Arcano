@baseUrl = http://localhost:3000

# MÓDULO AUTENTICAÇÃO #


### POST register user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "emailTrês@email.com",
  "password": "Abcefg123!",
  "name": "Usuário Três"
}


### POST user login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "email@email.com",
  "password": "Abcefg123!"
}

